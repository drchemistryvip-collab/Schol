rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email in ["hussein.zebary.chemistry96@gmail.com", "drlo96chemistry@gmail.com", "dr.chemistry.vip@gmail.com"] && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity validation helpers
    function isValidUser(data) {
      return data.keys().hasAny(['email']) &&
             data.email is string && data.email.size() <= 150;
    }

    function isValidContent(data) {
      return data.keys().hasAll(['title', 'type', 'grade', 'teacherId']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.type in ['video', 'quiz', 'malzama'] &&
             data.grade is string && data.grade.size() <= 20 &&
             data.teacherId is string && data.teacherId.size() <= 128;
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidUser(incoming());
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 2. Educational Content (Videos, Quizzes, Malzamas)
    match /educational_content/{contentId} {
      allow get: if true;
      allow list: if true;
      allow create: if isValidId(contentId) && isSignedIn() && isValidContent(incoming());
      allow update: if isValidId(contentId) && isSignedIn() &&
                       (isAdmin() || existing().teacherId == request.auth.uid || incoming().teacherId == existing().teacherId);
      allow delete: if isValidId(contentId) && isSignedIn() && (isAdmin() || existing().teacherId == request.auth.uid);
    }

    // 3. Teachers collection
    match /teachers/{teacherId} {
      allow get, list: if true;
      allow create, update: if isValidId(teacherId) && (isSignedIn() || isAdmin());
      allow delete: if isValidId(teacherId) && isAdmin();
    }

    // 4. Drive backups index
    match /drive_backups/{backupId} {
      allow get, list: if isSignedIn();
      allow create, update: if isValidId(backupId) && isSignedIn();
      allow delete: if isValidId(backupId) && (isSignedIn() || isAdmin());
    }

    // 5. Admins collection
    match /admins/{adminId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin() && isValidId(adminId);
    }
  }
}
